<?xml version='1.0' encoding='UTF-8'?>
<configuration>
  <input>
    <net-file value="sumo.net.xml"/>
    <route-files value="sumo.rou.xml"/>
  </input>
  <time>
    <end value="99999"/>
    <begin value="0"/>
  </time>
  <processing>
    <time-to-teleport value="45"/>
    <collision.action value="teleport"/>
    <collision.stoptime value="2"/>
    <waiting-time-memory value="100"/>
  </processing>
  <report>
    <verbose value="true"/>
    <no-step-log value="true"/>
  </report>
</configuration>
