<?xml version='1.0' encoding='UTF-8'?>
<configuration>
  <input>
    <net-file value="sumo.net.xml"/>
    <route-files value="sumo.rou.xml"/>
  </input>
  <time>
    <end value="99999"/>
    <begin value="0"/>
  </time>
  <processing>
    <!-- Anti-deadlock: teleport stuck vehicles after 45 seconds -->
    <time-to-teleport value="45"/>
    <collision.action value="teleport"/>
    <collision.stoptime value="2"/>
    <waiting-time-memory value="100"/>
    <!-- Realistic turning: vehicles slow down at corners -->
    <lateral-resolution value="0.8"/>
  </processing>
  <routing>
    <!-- Respect traffic lights and turning speed limits -->
    <routing-algorithm value="dijkstra"/>
  </routing>
  <report>
    <verbose value="true"/>
    <no-step-log value="true"/>
  </report>
</configuration>
